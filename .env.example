GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_DIRECTOR_MODEL=gemini-3.8-flash

# Azure narration: use a key + region, or the Azure CLI resource fields below.
SPEECH_KEY=
SPEECH_REGION=
