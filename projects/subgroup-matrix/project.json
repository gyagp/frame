    {
      "id": "math",
      "kind": "matrix",
      "duration": 16,
      "title": "The same mathematical contract.",
      "eyebrow": "01 / START WITH THE MATH",
      "body": "C′ = A × B + C",
      "narration": "Start with matrix multiply and accumulate. A has M rows and K columns. B has K rows and N columns. Each output adds a dot product to C. In this small example, the first result is fifty-nine.",
      "note": "Illustrative 2×3 and 3×2 matrices; not an advertised hardware tile",
      "camera": "locked"
    },
    {
      "id": "lanes",
      "kind": "lanes",
      "duration": 18,
      "title": "From individual work\nto one cooperative operation.",
      "eyebrow": "02 / CHANGE THE EXECUTION PATH",
      "body": "A subgroup is a hardware-sized team of lanes: a warp or wave.",
      "narration": "On the F M A path, lanes execute multiply-add instructions to build an output tile. With subgroup matrix operations, the lanes cooperate on matrix fragments and use matrix multiply hardware. The result is distributed across the subgroup.",
      "note": "Conceptual animation. Lane count and fragment layout are implementation-dependent.",
      "camera": "reveal"
    },
    {
      "id": "bridge",
      "kind": "pipeline",
      "duration": 18,
      "title": "One surface. Three native paths.",
      "eyebrow": "03 / THROUGH DAWN AND TINT",
      "body": "Validate capabilities first. Lower to the native backend.",
      "narration": "Dawn exposes an experimental Web G P U surface. Tint lowers the shader to Vulkan cooperative matrices, Metal SIMD-group operations, or D three D twelve wave matrices. The adapter must advertise the exact configuration. Hardware branding alone is not enough.",
      "note": "Source snapshot: D3D12 SM 6.10 LinAlg uses a preview runtime.",
      "camera": "pull"
    },
    {
      "id": "contract",
      "kind": "checklist",
      "duration": 16,
      "title": "Make the comparison fair.",
      "eyebrow": "04 / THE MEASUREMENT CONTRACT",
      "body": "Radeon RX 9070 XT · Windows · D3D12",
      "narration": "The supplied evaluation compares matched workloads on a Radeon R X ninety seventy X T. Inputs and shapes match. Results are checked against a CPU reference. GPU timestamps measure dispatch only, after warmup, with thirty measured samples.",
      "note": "f16 × f16 → f32 · preview driver 26.10.07.02 · historical measurements",
      "items": [
        "Same shapes and input data",
        "CPU reference validation",
        "Dispatch-only GPU timestamps",
        "Warmup + 30 measured samples"
      ],
      "camera": "locked"
    },
    {
      "id": "prefill",
      "kind": "benchmark",
      "duration": 18,
      "title": "Prefill 2048. A clear difference.",
      "eyebrow": "05 / REPLAY THE RECORDED RESULT",
      "body": "2048 × 3072 × 3072 · FP16 FMA baseline",
      "narration": "For the prefill twenty forty-eight workload, the recorded F M A result is thirteen point zero nine teraflops. LinAlg reaches forty-eight point nine seven. That is a three point seven four times gain in this matched test. This is a replay of recorded data.",
      "note": "Measured 21 Sep 2026 · RX 9070 XT · D3D12 · not a live benchmark",
      "baseline": 13.09,
      "result": 48.97,
      "camera": "locked"
    },
    {
      "id": "demo",
      "kind": "demo",
      "duration": 20,
      "title": "Explore the original demo.",
      "eyebrow": "06 / THE SOURCE, ON SCREEN",
      "body": "Choose a workload. Replay its measured comparison.",
      "narration": "The original demo lets you switch workloads and replay the comparison. Across its five D three D twelve cases, recorded speedups range from two point seven zero to four point one three times. These are workload-specific results, not a promise for every model or every GPU.",
      "note": "Captured from the supplied demo.html · recorded results, not live execution",
      "image": "assets/demo-prefill.png",
      "imageAlt": "assets/demo-mlp.png",
      "camera": "track"
    },
    {
      "id": "limits",
      "kind": "compare",
      "duration": 14,
      "title": "Keep the baseline in the frame.",
      "eyebrow": "07 / INTERPRET THE RESULT",
      "body": "A speedup belongs to a workload, a device, and a baseline.",
      "narration": "Vulkan uses an integer eight D P four A baseline. D three D twelve uses F P sixteen F M A. These results cannot rank APIs. One Vulkan case is slower.",
      "note": "RTX 5080 · Vulkan · Prefill 128: 0.89× vs INT8 DP4A",
      "camera": "locked"
    },
    {
      "id": "engineering",
      "kind": "checklist",
      "duration": 10,
      "title": "A usable path needs engineering.",
      "eyebrow": "08 / FROM FEATURE TO WORKING STACK",
      "body": "Capabilities → correctness → measurement",
      "narration": "Six Dawn changes fix setup, matrix loads, resource lifetime, and capability checks. Together, they enable the path.",
      "note": "Dawn CLs 326715 · 330695 · 331295 · 333935 · 335215 · 335895",
      "items": [
        "Build and resource lifetime",
        "Cooperative matrix loads",
        "Exact capability validation"
      ],
      "camera": "reveal"
    },
